# AI-Coach backend configuration.
# Copy this file to `.env` and fill in the values. Do NOT commit `.env`.
#
# PATHS: every path setting here is relative to backend/ (the directory this
# file lives in) — NOT to the repo root, and NOT to wherever you happen to
# launch from. config.py anchors them on its own location, so they resolve the
# same way whether uvicorn is started from the repo root (what
# .claude/launch.json does) or from inside backend/. Absolute paths are used
# as-is, so anything outside the repo still works.

# --- Database ---
DATABASE_URL=sqlite:///./ai_coach.db

# --- Auth / JWT (required) ---
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Google OAuth (required) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Email (required) ---
# Gmail SMTP. GMAIL_APP_PASSWORD is a 16-character App Password from
# https://myaccount.google.com/apppasswords (needs 2-Step Verification on);
# your normal account password will not work. Spaces in it are fine.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=
EMAIL_TIMEOUT_SECONDS=20
# Leave false so failed sends surface as an error instead of a silent "Code sent".
EMAIL_FAIL_SILENTLY=false

# --- Hugging Face (optional) ---
HF_TOKEN=

# --- LLM provider: Google Gemini (required) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_TOP_P=0.9
GEMINI_MAX_TOKENS=512

# Legacy Token Factory key — no longer used since the migration to Gemini.
LLM_API_KEY=

# --- Kokoro TTS ---
KOKORO_BASE_URL=http://kokoro:8880/v1
KOKORO_VOICE=af_bella
KOKORO_RESPONSE_FORMAT=mp3
KOKORO_TIMEOUT_SECONDS=30
KOKORO_AUTOSTART=false
KOKORO_DOCKER_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:latest
KOKORO_CONTAINER_NAME=coach-kokoro

# --- Whisper (faster-whisper) ---
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Tunisian Derja STT (LinTO/Vosk) ---
# Empty DERJA_STT_BACKEND = not installed; Arabic sessions fall back to
# multilingual Whisper pinned to "ar". Set to "vosk" after running
# backend/scripts/setup_linto_model.py (downloads linagora/linto-asr-ar-tn-0.1).
DERJA_STT_BACKEND=
DERJA_STT_MODEL_PATH=models/linto-asr-ar-tn/vosk-model

# --- Speech emotion recognition (services/emotion_model.py) ---
# Empty = disabled (analyze_emotion() always returns None). "xlsr" = the
# Eya-Jmaa/emotions_speech wav2vec2-large-xlsr-53 fine-tune — run
# `python backend/scripts/setup_emotion_model.py` first to download the
# ~1.26GB checkpoint to EMOTION_MODEL_PATH.
EMOTION_PROVIDER=
EMOTION_MODEL_PATH=models/emotion_xlsr/xlsr_best.pt
# Max 4.0s windows averaged per spoken turn. Cost is linear and machine-dependent
# (~4s per window measured on a CPU-only box, so 6 ≈ 25s of background compute per
# turn). It runs after the reply is delivered, but an interrupted turn loses its
# metrics — lower this on a slow machine or with fast back-and-forth turns.
EMOTION_MAX_CHUNKS=6

# --- Tunisian Derja TTS, local in-process inference (services/tts_service.py) ---
# Empty = disabled (SilmaEngine reports no audio, same as before). "local" =
# load the Eya-Jmaa/silma-tts-derja F5-TTS fine-tune in-process — run
# `python backend/scripts/setup_silma_tts.py` first. "http" = the ORIGINAL
# seam (SILMA_BASE_URL below), for anyone running SILMA as its own server.
# This is a voice-CLONING model: SILMA_REF_AUDIO_PATH/SILMA_REF_TEXT are
# REQUIRED for "local" — there is no default speaker.
#
# The reference clip must exist on the machine running the backend; nothing
# fetches it. The one we settled on is F5-TTS's own bundled English sample,
# copied out of the installed package into the repo:
#   cp backend/venv/Lib/site-packages/f5_tts/infer/examples/basic/basic_ref_en.wav \
#      backend/data/tts_reference/basic_ref_en.wav
# then point SILMA_REF_AUDIO_PATH at it with an ABSOLUTE path, and set
# SILMA_REF_TEXT to that clip's exact transcript (below). It beat every
# Tunisian Arabic candidate tested, at the cost of an English accent on the
# Derja output — see the TODO in services/tts_service.py.
SILMA_PROVIDER=
SILMA_MODEL_DIR=models/silma-tts-derja
SILMA_REF_AUDIO_PATH=
SILMA_REF_TEXT=Some call me nature, others call me mother nature.

# --- FFmpeg shared build (required once torchaudio is installed, e.g. via f5-tts) ---
# torchcodec (a transitive dependency of torchaudio) wraps FFmpeg's decode
# libraries without bundling them. Once torchaudio is merely INSTALLED,
# sentence-transformers probes it at import — so a missing FFmpeg breaks RAG
# too, not just TTS. Empty = skipped (fine if you never installed f5-tts).
#
# Setup (Windows):
#   1. Download ffmpeg-release-full-shared.7z from
#      https://www.gyan.dev/ffmpeg/builds/
#      NOTE: `winget install Gyan.FFmpeg` gives the *static* build (one .exe,
#      no DLLs) and does NOT work for torchcodec. It must be "full-shared".
#   2. Extract it somewhere permanent, e.g. C:\ffmpeg
#   3. Point this at the bin/ folder inside it (the one containing
#      avcodec-*.dll), e.g. C:\ffmpeg\ffmpeg-<version>-full_build-shared\bin
#   4. Restart the backend. config.py registers it via os.add_dll_directory()
#      — note that putting it on your system PATH is NOT sufficient, because
#      Python 3.8+ on Windows ignores PATH when resolving dependent DLLs.
FFMPEG_BIN_DIR=

# --- Video/face analysis (headshot: expression, gaze, self-touch, head motion) ---
VIDEO_ANALYSIS_ENABLED=true
FACE_EXPRESSION_MODEL=enet_b0_8_best_afew
FACE_EXPRESSION_EVERY_N=3
FACE_MIN_FRAME_INTERVAL_MS=450
FACE_ENGAGEMENT_ENABLED=false

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
