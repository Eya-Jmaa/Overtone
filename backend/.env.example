# AI-Coach backend configuration.
# Copy this file to `.env` and fill in the values. Do NOT commit `.env`.

# --- Database ---
DATABASE_URL=sqlite:///./ai_coach.db

# --- Auth / JWT (required) ---
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Google OAuth (required) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Email (required) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=

# --- Hugging Face (optional) ---
HF_TOKEN=

# --- LLM provider: Google Gemini (required) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_TOP_P=0.9
GEMINI_MAX_TOKENS=512

# Legacy Token Factory key — no longer used since the migration to Gemini.
LLM_API_KEY=

# --- Kokoro TTS ---
KOKORO_BASE_URL=http://kokoro:8880/v1
KOKORO_VOICE=af_bella
KOKORO_RESPONSE_FORMAT=mp3
KOKORO_TIMEOUT_SECONDS=30
KOKORO_AUTOSTART=false
KOKORO_DOCKER_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:latest
KOKORO_CONTAINER_NAME=coach-kokoro

# --- Whisper (faster-whisper) ---
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
